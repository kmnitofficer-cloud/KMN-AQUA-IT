# Google Apps Script Web App URL for direct Google Drive Cloud Database connection
# 1. Deploy google-apps-script/Code.gs as a Web App (access: "Anyone")
# 2. Paste your Web App URL below:
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec

# Security & Authentication Credentials (will be hashed during build)
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=admin123
VITE_USER_USERNAME=user
VITE_USER_PASSWORD=user123
